# ==============================================================================
# Exemplo da stack de desenvolvimento docker-compose.yml.
# PRODUÇÃO: use .env.production.example + compose.production.yaml.
# Copie para ".env" (mesma pasta do docker-compose.yml) e preencha.
# NUNCA comite o .env nem o JSON da Service Account.
# ==============================================================================

# ---- Banco de dados (PostgreSQL no container 'db') ---------------------------
POSTGRES_USER=certuser
POSTGRES_PASSWORD=TROQUE_por_uma_senha_forte
POSTGRES_DB=certificados
DATABASE_URL=postgresql://certuser:TROQUE_por_uma_senha_forte@db:5432/certificados?sslmode=disable
# Alternativa para banco externo/secret file: DATABASE_URL_FILE=/run/secrets/database_url

# ---- Ambiente ----------------------------------------------------------------
# FASE DE TESTE (sem domínio, HTTP): use development + cookie não-secure abaixo.
# DEPOIS (com domínio + HTTPS): troque para APP_ENV=production e REMOVA a linha
# AUTH_COOKIE_SECURE (o cookie passa a Secure automaticamente).
APP_ENV=development
AUTH_COOKIE_SECURE=false

# ---- Segredos (gere aleatórios; mínimo 32 bytes; valores DIFERENTES) ---------
#   Linux:  openssl rand -base64 48
JWT_SECRET=GERAR_32+_bytes_aleatorios
DOCUMENT_HASH_SECRET=GERAR_OUTRO_32+_bytes_aleatorios
# Em desenvolvimento, deixe em branco: o runtime usa uma chave efêmera de
# desenvolvimento. Perfis hardened/LAN usam a keyring gerada por bootstrap.
BATCH_PAYLOAD_KEYS=
BATCH_PAYLOAD_ACTIVE_KEY_ID=

# ---- Usuário administrativo inicial (criado no 1º start) ---------------------
ADMIN_INITIAL_USERNAME=secretaria
ADMIN_INITIAL_PASSWORD=Desenvolvimento-Local-2026!
ADMIN_INITIAL_ROLE=admin

# ---- URLs / CORS / proxy -----------------------------------------------------
# Perfil Docker de DESENVOLVIMENTO. A SPA administrativa sai em :8080 e a
# consulta pública em :80. Para o servidor LAN, use .env.local-server.
ADMIN_FRONTEND_URL=http://localhost:8080
PUBLIC_VALIDATION_BASE_URL=http://localhost
# Confiar no X-Forwarded-For vindo do nginx (rede interna do compose).
TRUSTED_PROXY_CIDRS=172.16.0.0/12
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---- Armazenamento ------------------------------------------------------------
# O Docker local usa volume persistente; assim funciona sem internet/Google.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/storage
# Google Drive é opcional no desenvolvimento; configure as credenciais somente
# quando for testar essa integração, conforme docs/GOOGLE_DRIVE.md.
# GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_DRIVE_ACCESS_MODE=read_write
# Compatibilidade legada; novas emissões escolhem uma pasta por evento.
GOOGLE_DRIVE_CERTIFICATES_FOLDER_ID=
GOOGLE_PICKER_CLIENT_ID=
# Arquivo no host contendo somente o Client Secret. O Compose o monta em
# /run/secrets; não coloque o valor diretamente neste .env.
GOOGLE_PICKER_CLIENT_SECRET_FILE=
# Chave limitada à Google Picker API, sem HTTP referrer restriction: a
# validação é realizada dentro do iframe oficial docs.google.com.
GOOGLE_PICKER_API_KEY_FILE=
GOOGLE_PICKER_APP_ID=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google-drive/oauth/callback
GOOGLE_DRIVE_UPLOAD_PRINCIPAL_EMAIL=
GOOGLE_DRIVE_PUBLIC_READER_EMAIL=
# Conteúdo do JSON da Service Account em base64 (NUNCA o JSON cru):
#   Linux:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa para Meu Drive pessoal:
# GOOGLE_DRIVE_AUTH_MODE=oauth_user
# GOOGLE_OAUTH_TOKEN_JSON_BASE64=COLE_O_BASE64_DO_TOKEN_OAUTH

# ---- Frontend (build) --------------------------------------------------------
# "/api" = mesma origem da SPA admin (porta 8080) → sem CORS/cookie cross-origin.
VITE_API_BASE_URL=/api

# ---- Workers (2 núcleos / 2-4 GB) --------------------------------------------
# Comece com 1 cada. Com 4 GB pode subir admin para 2.
ADMIN_WORKERS=1
CONSULTA_WORKERS=1
BATCH_WORKER_MODE=external
MAX_SPREADSHEET_SIZE_MB=10
MAX_SPREADSHEET_ROWS=2000
MAX_ZIP_CERTIFICATES=100
MAX_ZIP_TOTAL_BYTES=209715200
