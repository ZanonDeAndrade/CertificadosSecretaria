# Controla o que o `gcloud builds submit` ENVIA ao Cloud Build. Segredos e
# artefatos pesados nunca sobem.
.git/
.gitignore
.github/

# Segredos — NUNCA enviar
secrets/
.env*
**/.env*
*service-account*.json
*service_account*.json
*serviceaccount*.json
client_secret*.json
*oauth*token*.json
token.json
credentials*.json

