# Copie para .env.local-server. Este perfil é exclusivamente para rede local.
# O IP fica em uma variável, nunca no código: altere somente LOCAL_SERVER_URL
# quando o servidor mudar de endereço ou quando um domínio/HTTPS for adotado.
APP_ENV=local_server
TZ=America/Sao_Paulo
HTTP_PORT=80
LOCAL_SERVER_URL=http://192.168.2.192
ADMIN_FRONTEND_URL=${LOCAL_SERVER_URL}
PUBLIC_VALIDATION_BASE_URL=${LOCAL_SERVER_URL}
PUBLIC_SITE_BASE_PATH=/consulta
CORS_ALLOWED_ORIGINS=${LOCAL_SERVER_URL}
TRUSTED_PROXY_CIDRS=172.29.0.0/24
FORWARDED_ALLOW_IPS=172.29.0.0/24

POSTGRES_USER=certificados
POSTGRES_DB=certificados
DATABASE_URL_FILE=/run/secrets/database_url
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/storage
MAX_CERTIFICATE_FILE_SIZE_MB=10
MAX_SPREADSHEET_SIZE_MB=10
MAX_SPREADSHEET_ROWS=2000
MAX_ZIP_CERTIFICATES=100
MAX_ZIP_TOTAL_BYTES=104857600
DOWNLOAD_TEMP_DIR=/tmp/certificados-downloads

JWT_SECRET_FILE=/run/secrets/jwt_secret
DOCUMENT_HASH_KEYRING_FILE=/run/secrets/document_hash_keyring
DOCUMENT_HASH_ACTIVE_KEY_ID=v1
BATCH_PAYLOAD_KEYS_FILE=/run/secrets/batch_payload_keys
BATCH_PAYLOAD_ACTIVE_KEY_ID=v1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
JWT_EXPIRES_IN_MINUTES=480
MINIMIZE_DOCUMENT_PLAINTEXT=true

# O bootstrap grava a senha em um Docker secret, não neste arquivo.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_ROLE=admin
ADMIN_INITIAL_PASSWORD_FILE=/run/secrets/admin_initial_password

BATCH_WORKER_MODE=external
BATCH_WORKER_DISPATCH_MODE=resident
BATCH_MAX_ATTEMPTS=3
BATCH_LEASE_SECONDS=600
ADMIN_WORKERS=1
CONSULTA_WORKERS=1

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_MAX_FAILURES_PER_USER=8
LOGIN_LOCKOUT_SECONDS=900
PUBLIC_RATE_LIMIT_REQUESTS=60
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_NAME_RATE_LIMIT_REQUESTS=30
PUBLIC_CONFIRM_RATE_LIMIT_REQUESTS=8
PUBLIC_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=900

LOCAL_SECRETS_DIR=./secrets/local-server
