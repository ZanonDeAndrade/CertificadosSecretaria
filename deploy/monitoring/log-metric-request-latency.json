{
  "name": "certificados_request_duration_ms",
  "description": "Distribuicao de latencia HTTP, sem query string.",
  "filter": "jsonPayload.logger=\"certificados.metrics\" AND jsonPayload.metric=\"request_duration_ms\" AND jsonPayload.metric_kind=\"distribution_sample\"",
  "valueExtractor": "EXTRACT(jsonPayload.value)",
  "bucketOptions": {
    "exponentialBuckets": {
      "numFiniteBuckets": 20,
      "growthFactor": 2,
      "scale": 1
    }
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms"
  }
}
