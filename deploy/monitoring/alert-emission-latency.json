{
  "displayName": "Certificados | emissao lenta p95",
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "O p95 dos jobs de emissao superou 15 minutos. Verifique fila, Drive e limites de instancias.",
    "mimeType": "text/markdown"
  },
  "conditions": [{
    "displayName": "p95 maior que 15min",
    "conditionThreshold": {
      "filter": "metric.type=\"logging.googleapis.com/user/certificados_emission_job_duration_ms\" AND resource.type=\"cloud_run_job\"",
      "comparison": "COMPARISON_GT",
      "thresholdValue": 900000,
      "duration": "300s",
      "aggregations": [{
        "alignmentPeriod": "300s",
        "perSeriesAligner": "ALIGN_PERCENTILE_95",
        "crossSeriesReducer": "REDUCE_PERCENTILE_95"
      }],
      "trigger": {"count": 1}
    }
  }]
}
